# Copy this file to .env and replace the examples before starting the server.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000
CINEMA_TIMEZONE=Asia/Qyzylorda
# Optional: a separate database file. By default cinema.db is next to server.js.
# DB_PATH=/path/to/cinema.db
